# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Node
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
pnpm-lock.yaml
yarn.lock

# Build output
/build/
/dist/
/out/

# Environment / local files
.env
.env.*.local
.local.env
*.local

# Logs
*.log

# IDEs and editors
.vscode/
.idea/
*.iml

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Android
AndroidApp/.gradle/
AndroidApp/app/build/
AndroidApp/captures/
AndroidApp/.externalNativeBuild/
AndroidApp/.cxx/
AndroidApp/local.properties
AndroidApp/output-metadata.json
AndroidApp/*.apk
AndroidApp/*.aab
AndroidApp/*.hprof
AndroidApp/*.jks
AndroidApp/*.keystore
AndroidApp/google-services.json

# Android Studio
AndroidApp/.idea/
AndroidApp/*.iml

# Generated files
**/build/
**/dist/

# Optional: ignore system files and temp
*.tmp
*.temp
*.swp
*~

# Ignore package manager temp files
.pnpm-debug.log*

tests/__snapshots__/

# Keep this project clean
.idea/
.vscode/
